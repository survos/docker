#!/usr/bin/env bash
# Bring up the shared dev services. Run once after every reboot.
#
#   bin/start                 everything: the whole shared stack, plus ES (Kibana is opt-in: bin/start kibana)
#   bin/start core            the minimum for working on a public-facing site
#   bin/start redis mailer    just the named services
#
# core uses lightweight postgres-lite (5434), elasticsearch
# (9200) and redis (6379, the cache/session store in nearly every site's .env).
# A designer never needs mariadb, rabbitmq, mercure, kibana...
#
# RabbitMQ is not in core on purpose: Symfony only connects to it when a message
# is dispatched, so pages render fine without it. If a form submit fails with an
# AMQP connection error, `bin/start rabbitmq`.
#
# Grist is in neither; use grist.survos.com, or `bin/start grist`.
set -euo pipefail
cd "$(dirname "$0")/.."

CORE=(postgres-lite elasticsearch redis)

case "${1:-}" in
    "")    # every unprofiled service, plus the ondemand ones worth having locally
           services=($(docker compose config --services | grep -vx postgres-lite) elasticsearch) ;;
    core)  services=("${CORE[@]}") ;;
    -h|--help) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *)     services=("$@") ;;
esac
# On the Mac the daemon lives in the podman VM, which doesn't start at boot.
# `podman machine start` prints a page of rootful/helper/DOCKER_HOST advice that
# doesn't apply here (DOCKER_HOST is set just below), so only its errors show.
if [ "$(uname)" = Darwin ] && command -v podman >/dev/null; then
    if [ "$(podman machine inspect --format '{{.State}}' 2>/dev/null)" != running ]; then
        echo "Starting podman VM..."
        podman machine start >/dev/null
    fi
    # .zshrc sets this, but non-interactive shells don't read it.
    : "${DOCKER_HOST:=unix://$(podman machine inspect --format '{{.ConnectionInfo.PodmanSocket.Path}}')}"
    export DOCKER_HOST
    # The VM can report "running" after gvproxy has died, leaving no API socket.
    if ! docker info >/dev/null 2>&1; then
        echo "Podman API not responding; restarting podman VM..."
        podman machine stop >/dev/null
        podman machine start >/dev/null
    fi
fi

# Both database variants serve the same app connection URL. Never stop a running
# database implicitly or mount its data in the other image.
requested_postgres=""
for service in "${services[@]}"; do
    case "$service" in
        postgres|postgres-lite)
            if [ -n "$requested_postgres" ] && [ "$requested_postgres" != "$service" ]; then
                echo "Choose postgres OR postgres-lite; both use port 5434." >&2
                exit 1
            fi
            requested_postgres="$service"
            ;;
    esac
done
if [ -n "$requested_postgres" ]; then
    other_postgres=postgres
    [ "$requested_postgres" = postgres ] && other_postgres=postgres-lite
    running_services=$(docker compose --profile '*' ps --status running --services)
    if grep -qx "$other_postgres" <<< "$running_services"; then
        echo "$other_postgres is already using port 5434. Run bin/stop $other_postgres before switching to $requested_postgres." >&2
        echo "Their databases are separate; existing data stays in its original volume." >&2
        exit 1
    fi
fi

# Naming a profiled service (elasticsearch, kibana) enables its profile.
docker compose up -d "${services[@]}"

if [ -f /etc/apparmor.d/php-fpm ]; then
    # Linux dev box only: the apparmor-profiles package resets php-fpm to
    # enforcing on every reboot, which blocks it from reading app files
    # ("Access denied." on every *.wip app). Needs sudo.
    sudo apparmor_parser -C -r /etc/apparmor.d/php-fpm
fi
