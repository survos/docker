#!/usr/bin/env bash
# whyload -- one-shot answer to "something is causing load to climb".
#
# Reads a single 3-second sample and prints only what distinguishes the four
# things load can actually mean. No daemons, no polling, no background jobs.
#
#   whyload           summary
#   whyload -v        summary + the full per-process and container tables

set -uo pipefail
verbose=0; [ "${1:-}" = "-v" ] && verbose=1

cores=$(nproc)
read -r _ _ _ _ _ _ _ _ _ _ l1 l5 l15 _ < <(echo "x $(cat /proc/loadavg)")
l1=$(cut -d' ' -f1 /proc/loadavg); l5=$(cut -d' ' -f2 /proc/loadavg); l15=$(cut -d' ' -f3 /proc/loadavg)

printf '\n\033[1mload\033[0m  %s (1m)  %s (5m)  %s (15m)   across %s cores\n' "$l1" "$l5" "$l15" "$cores"

# Shape: is this a burst that will decay, or something that is still growing?
# Trend first, magnitude second. A rising 1m>5m>15m at half capacity still matters --
# checking "is it high yet" first hides exactly the case worth catching early.
awk -v a="$l1" -v b="$l5" -v c="$l15" -v n="$cores" 'BEGIN {
  if (a > b && b > c)       s="CLIMBING -- 1m > 5m > 15m, still ramping";
  else if (a < b && b > c)  s="DECAYING -- a burst that already ended, will fall on its own";
  else if (a < n*0.5)       s="quiet";
  else                      s="SUSTAINED -- flat and high, something is parked on the CPU";
  printf "shape %s\n", s
}'

# CPU vs I/O. This is the fork in the road: high load with wa>20 is disk/NFS/rclone,
# not compute, and the process list below will look deceptively idle.
echo
vmstat 1 3 | tail -1 | awk '{
  printf "\033[1mcpu\033[0m   %s%% user  %s%% sys  %s%% idle  %s%% iowait   runnable=%s  blocked=%s\n", $13,$14,$15,$16,$1,$2
  if ($16+0 > 20) print "      -> I/O bound. Suspect a stalled mount (rclone, NFS, USB) before suspecting CPU."
  else if ($2+0 > 2) print "      -> processes blocked in D state; check the mount table below."
  else print "      -> genuinely CPU bound. The top consumers below are the answer."
}'

# D-state is the tell for a hung mount -- these do not burn CPU but do count toward load.
d=$(ps -eo stat= | grep -c '^D')
if [ "$d" -gt 0 ]; then
  echo
  printf '\033[1mblocked in D state (%s)\033[0m -- uninterruptible, usually a stuck filesystem\n' "$d"
  ps -eo pid,stat,wchan:22,etime,comm --sort=-etime | awk 'NR==1 || $2 ~ /^D/' | head -12
fi

# rclone/fuse mounts: a flapping one shows as load with no CPU, and is easy to miss.
if mount | grep -qE 'fuse\.rclone|fuse\.sshfs'; then
  echo
  printf '\033[1mfuse mounts\033[0m (a stalled one inflates load invisibly)\n'
  mount | grep -E 'fuse\.rclone|fuse\.sshfs' | sed 's/^/  /'
fi

echo
printf '\033[1mtop cpu\033[0m (rolled up by command, so 40 chrome renderers read as one line)\n'
ps -eo pcpu,comm --no-headers | grep -vE ' (ps|awk|sort|vmstat|whyload)$' | awk '{c[$2]+=$1} END {for (k in c) if (c[k]>=1.0) printf "%7.1f%%  %s\n", c[k], k}' | sort -rn | head -12

echo
printf '\033[1mtop rss\033[0m\n'
ps -eo rss,comm --no-headers | awk '{c[$2]+=$1} END {for (k in c) if (c[k]>200000) printf "%7.1f GB  %s\n", c[k]/1048576, k}' | sort -rn | head -8

# Containers are the usual source of "load with no visible process" on this box.
if command -v docker >/dev/null 2>&1; then
  echo
  n=$(docker ps -q 2>/dev/null | wc -l)
  printf '\033[1mdocker\033[0m  %s running\n' "$n"
  if [ "$n" -gt 0 ]; then
    docker stats --no-stream --format '  {{.CPUPerc}}\t{{.MemUsage}}\t{{.Name}}' 2>/dev/null \
      | sort -rn | head -8
  fi
fi

if [ "$verbose" = 1 ]; then
  echo
  printf '\033[1mall processes over 1%% cpu\033[0m\n'
  ps -eo pid,user,pcpu,pmem,etime,args --sort=-pcpu --no-headers | awk '$3>=1.0' | cut -c1-160 | head -30
fi
echo
