#!/usr/bin/env python3
"""Publish and atomically upload a release to the existing authenticated fsn1 registry."""
import argparse
import fcntl
from pathlib import Path
import shlex
import shutil
import subprocess

root = Path(__file__).resolve().parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('tag')
parser.add_argument('--package', action='append', default=[])
args = parser.parse_args()
(root / 'var').mkdir(exist_ok=True)
lock = (root / 'var/.deploy.lock').open('w')
fcntl.flock(lock, fcntl.LOCK_EX)
compose = ['docker-compose'] if shutil.which('docker-compose') else ['docker', 'compose']
command = [*compose, 'run', '--rm', 'satis-publisher', '--data', '/data/remote',
           '--tag', args.tag, '--url', 'https://satis.survos.com']
for package in args.package:
    command += ['--package', package]
subprocess.run(command, cwd=root.parent, check=True)
release = (root / 'var/remote/current').readlink()
subprocess.run(['rsync', '-a', '--exclude', 'current', str(root / 'var/remote') + '/',
                'fsn1-root:/var/lib/dokku/data/storage/satis/'], check=True)
if len(release.parts) != 2 or release.parts[0] != 'releases':
    raise ValueError('Unexpected release link')
# All files are uploaded first. The live pointer is replaced on the same filesystem.
remote = ('cd /var/lib/dokku/data/storage/satis && ln -sfn ' + shlex.quote(str(release))
          + ' .current-next && mv -Tf .current-next current')
subprocess.run(['ssh', '-o', 'BatchMode=yes', 'fsn1-root', remote], check=True)
subprocess.run(['python3', str(root / 'verify.py'), '--url', 'https://satis.survos.com',
                '--auth', str(root / 'var/remote-secrets/auth.json')], check=True)
