{
    auto_https off
    admin off
}
:8080 {
    handle /healthz {
        respond "ok" 200
    }
    handle {
        basic_auth {
            {$SATIS_USERNAME} {$SATIS_PASSWORD_HASH}
        }
        root * /srv/current
        header Cache-Control "private, no-store"
        file_server
    }
}
